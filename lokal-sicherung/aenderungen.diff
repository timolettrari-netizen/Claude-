+{"exercises":{"gob":{"name":"Goblet Squat","equipment":"Kurzhantel oder Kettlebell (zuhause: gefüllter Rucksack)","steps":["Hüftbreit stellen, Fußspitzen leicht nach außen.","Gewicht senkrecht vor der Brust halten, Ellbogen zeigen nach unten.","Hüfte nach hinten-unten setzen, bis die Oberschenkel mindestens waagerecht sind.","Über die ganze Fußsohle kraftvoll nach oben drücken."],"mistakes":"Knie zeigen in Richtung Fußspitzen, Fersen bleiben am Boden, Brust bleibt oben.","why":"Grundkraft der Beine für Absprung und stabile Grundstellung.","sets":3,"reps":10,"unit":"reps","prop":"db1","gym":{"name":"Kniebeuge mit Langhantel","equipment":"Langhantel im Rack","steps":["Stange auf den oberen Rücken legen, schulterbreit greifen.","Aus dem Rack lösen, 2 Schritte zurück, hüftbreit stehen.","Hüfte nach hinten-unten setzen, bis Oberschenkel waagerecht.","Kraftvoll hochdrücken."],"mistakes":"Knie Richtung Zehen, Rücken gerade, Fersen unten."},"home":"Goblet Squat mit Rucksack","photo":"Goblet_Squat","photoGym":"Barbell_Squat","anim":{"a":"stG","b":"sq","hop":0,"period":3}},"bss":{"name":"Bulgarian Split Squat","equipment":"Bank oder Stuhl, optional Kurzhanteln","steps":["Mit dem Rücken zur Bank stellen, einen Fußrücken hinten auf die Bank legen.","Vorderen Fuß so weit nach vorne setzen, dass das Knie unten über dem Fuß steht.","Senkrecht nach unten gehen, bis das hintere Knie fast den Boden berührt.","Über die vordere Ferse hochdrücken. Erst alle Wdh. einer Seite."],"mistakes":"Vorderes Knie nicht nach innen fallen lassen. Oberkörper leicht nach vorne geneigt.","why":"Einbeinige Kraft – jeder Absprung zur Parade ist einbeinig.","sets":3,"reps":8,"unit":"reps","prop":"benchB","gym":null,"home":null,"photo":"Split_Squat_with_Dumbbells","photoGym":null,"anim":{"a":"lunT","b":"lunB","hop":0,"period":3}},"rdl":{"name":"Einbeiniges Kreuzheben","equipment":"1–2 Kurzhanteln","steps":["Auf einem Bein stehen, Knie minimal gebeugt.","Oberkörper nach vorne kippen, freies Bein streckt sich nach hinten – wie eine Wippe.","Gewichte nah am Standbein nach unten führen, bis Rücken und Bein fast waagerecht sind.","Mit Gesäß und Oberschenkelrückseite wieder aufrichten."],"mistakes":"Rücken bleibt gerade, Hüfte bleibt parallel zum Boden (nicht aufdrehen).","why":"Starke Oberschenkelrückseite schützt vor Zerrungen beim Antritt.","sets":3,"reps":8,"unit":"reps","prop":"db2","gym":{"name":"Rumänisches Kreuzheben","equipment":"Langhantel","steps":["Stange schulterbreit vor den Oberschenkeln halten.","Knie leicht gebeugt, Hüfte weit nach hinten schieben.","Stange gleitet nah an den Beinen bis unter die Knie.","Mit dem Gesäß nach vorne aufrichten."],"mistakes":"Rücken gerade, Stange bleibt am Körper."},"home":null,"photo":"Kettlebell_One-Legged_Deadlift","photoGym":"Romanian_Deadlift","anim":{"a":"st","b":"rdl","hop":0,"period":3.4}},"cop":{"name":"Copenhagen Plank","equipment":"Bank oder Stuhl, Matte","steps":["Seitlich auf den Unterarm legen, Ellbogen unter der Schulter.","Oberes Bein mit der Innenseite des Knies (leichter) oder des Fußes (schwer) auf die Bank legen.","Hüfte anheben, bis der Körper eine gerade Linie bildet.","Position halten, ruhig atmen. Dann Seite wechseln."],"mistakes":"Hüfte nicht durchhängen lassen. Bei Leistenschmerz sofort stoppen.","why":"Kräftigt die Adduktoren – die häufigste Verletzungsstelle bei Torhütern.","sets":3,"reps":20,"unit":"s","prop":"benchF","gym":null,"home":null,"photo":"Gen_cop","photoGym":null,"anim":{"a":"spl1","b":"spl2","hop":0,"period":3}},"nord":{"name":"Nordic Hamstring Curl","equipment":"Matte + Partner oder Sprossenwand/Sofa zum Fixieren der Fersen","steps":["Aufrecht knien, Fersen werden festgehalten oder eingeklemmt.","Körper als gerade Linie langsam nach vorne sinken lassen.","So lange wie möglich bremsen, dann mit den Händen abfangen.","Mit den Händen leicht abdrücken und zurück in die Ausgangsposition."],"mistakes":"Hüfte bleibt gestreckt (nicht abknicken). Langsam ist wichtiger als tief.","why":"Beste Übung zur Vorbeugung von Oberschenkelzerrungen.","sets":3,"reps":5,"unit":"reps","prop":"pad","gym":null,"home":null,"photo":"Natural_Glute_Ham_Raise","photoGym":null,"anim":{"a":"nor1","b":"nor2","hop":0,"period":4}},"calf":{"name":"Wadenheben einbeinig","equipment":"Stufe oder Treppe","steps":["Mit dem Fußballen auf eine Stufe stellen, an der Wand festhalten.","Ferse langsam unter Stufenhöhe absenken.","Explosiv auf die Zehenspitzen drücken und oben 1 Sekunde halten."],"mistakes":"Volle Bewegung, Knie gestreckt, nicht wippen.","why":"Schnellkraft aus dem Sprunggelenk für den ersten Schritt.","sets":3,"reps":12,"unit":"reps","prop":"step","gym":{"name":"Wadenheben an der Maschine","equipment":"Wadenmaschine oder Stufe + Kurzhantel","steps":null,"mistakes":null},"home":null,"photo":"Standing_Dumbbell_Calf_Raise","photoGym":"Standing_Calf_Raises","anim":{"a":"st","b":"toe","hop":8,"period":2}},"lat":{"name":"Seitliche Ausfallschritte","equipment":"Optional Kurzhantel","steps":["Breiter Stand, Hände vor der Brust.","Gewicht auf ein Bein verlagern und dort tief in die Hocke gehen, anderes Bein bleibt gestreckt.","Kraftvoll zurück in die Mitte drücken."],"mistakes":"Ferse des gebeugten Beins bleibt am Boden, Brust bleibt oben.","why":"Kraft für seitliche Bewegungen auf der Torlinie.","sets":3,"reps":8,"unit":"reps","prop":"db1","gym":null,"home":null,"photo":"Barbell_Side_Split_Squat","photoGym":null,"anim":{"a":"lat1","b":"lat2","hop":0,"period":3}},"push":{"name":"Liegestütz","equipment":"Matte","steps":["Hände etwas breiter als schulterbreit, Körper bildet eine gerade Linie.","Brust kontrolliert bis knapp über den Boden senken, Ellbogen ca. 45° vom Körper.","Kraftvoll hochdrücken."],"mistakes":"Bauch und Gesäß fest – kein Hohlkreuz. Zu schwer? Knie ablegen.","why":"Stabile Arme und Schultern zum Abwehren und Fausten.","sets":3,"reps":12,"unit":"reps","prop":"mat","gym":null,"home":null,"photo":"Pushups","photoGym":null,"anim":{"a":"pu1","b":"pu2","hop":0,"period":2.4}},"row":{"name":"Kurzhantel-Rudern","equipment":"Kurzhanteln (zuhause: Wasserkanister)","steps":["Leicht in die Knie, Oberkörper ca. 45° nach vorne, Rücken gerade.","Gewichte hängen unter den Schultern.","Ellbogen nach hinten zur Hüfte ziehen, Schulterblätter zusammen.","Langsam ablassen."],"mistakes":"Nicht mit Schwung arbeiten, Nacken lang lassen.","why":"Starker oberer Rücken für weite Abwürfe und gesunde Schultern.","sets":3,"reps":10,"unit":"reps","prop":"db2","gym":{"name":"Kabelrudern sitzend","equipment":"Kabelzug mit Griff","steps":["Aufrecht sitzen, Füße an die Platte.","Griff zum Bauch ziehen, Schulterblätter zusammen.","Langsam nach vorne zurückführen."],"mistakes":"Oberkörper bleibt ruhig."},"home":null,"photo":"Bent_Over_Two-Dumbbell_Row","photoGym":"Seated_Cable_Rows","anim":{"a":"row1","b":"row2","hop":0,"period":2.4}},"ohp":{"name":"Schulterdrücken stehend","equipment":"Kurzhanteln","steps":["Aufrecht stehen, Hanteln auf Schulterhöhe.","Bauch und Gesäß anspannen.","Gewichte senkrecht über den Kopf drücken, bis die Arme gestreckt sind.","Kontrolliert zurück zu den Schultern."],"mistakes":"Kein Hohlkreuz, Rippen unten lassen.","why":"Kraft über Kopf – hohe Bälle fangen und fausten.","sets":3,"reps":8,"unit":"reps","prop":"db2","gym":null,"home":"Pike Push-up","photo":"Dumbbell_Shoulder_Press","photoGym":null,"anim":{"a":"oh1","b":"oh2","hop":0,"period":2.6}},"pall":{"name":"Pallof Press","equipment":"Widerstandsband (Gym: Kabelzug)","steps":["Seitlich zur Befestigung stehen, Band mit beiden Händen vor der Brust.","Arme langsam gerade nach vorne strecken – das Band zieht zur Seite.","2 Sekunden halten, nicht verdrehen lassen.","Zurück zur Brust. Seiten wechseln."],"mistakes":"Hüfte und Schultern zeigen immer nach vorne.","why":"Rumpfstabilität bei Zusammenstößen und Paraden.","sets":3,"reps":10,"unit":"reps","prop":"band","gym":{"name":"Pallof Press am Kabelzug","equipment":"Kabelzug auf Brusthöhe","steps":null,"mistakes":null},"home":null,"photo":"Pal