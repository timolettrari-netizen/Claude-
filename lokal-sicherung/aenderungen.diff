sh2","hop":4,"period":0.8}},"wall":{"name":"Ball gegen Wand fangen","equipment":"Ball (oder Tennisball) und eine Wand","steps":["1–2 m vor der Wand in Grundstellung.","Ball gegen die Wand werfen und sicher fangen.","Tempo steigern, Höhe und Seite variieren."],"mistakes":"Hände bilden ein „W“ hinter dem Ball.","why":"Reaktion und sichere Hände.","sets":3,"reps":40,"unit":"s","prop":"wall","gym":null,"home":null,"photo":"Gen_wall","photoGym":null,"anim":{"a":"ca1","b":"ca2","hop":0,"period":0.8}},"drop":{"name":"Fallender Ball","equipment":"Tennisball, Partner","steps":["Partner hält auf Schulterhöhe einen Ball in jeder Hand.","Er lässt ohne Vorwarnung einen fallen.","Ball fangen, bevor er ein zweites Mal aufspringt."],"mistakes":"Aus der Grundstellung starten, nicht vorher bewegen.","why":"Reaktionsschnelligkeit.","sets":3,"reps":10,"unit":"reps","prop":"ball","gym":null,"home":null,"photo":"Gen_drop","photoGym":null,"anim":{"a":"ca1","b":"dr2","hop":0,"period":1.6}},"w90":{"name":"90/90 Hüftrotation","equipment":"Matte","steps":["Sitzen, vorderes Bein 90° vor dir, hinteres 90° zur Seite.","Aufrecht sitzen, Hände hinter dir abstützen.","Beide Knie langsam auf die andere Seite drehen."],"mistakes":"Aufrecht bleiben, langsam bewegen.","why":"Bewegliche Hüfte für tiefe Paraden.","sets":2,"reps":10,"unit":"reps","prop":"mat","gym":null,"home":null,"photo":"Gen_w90","photoGym":null,"anim":{"a":"se1","b":"se2","hop":0,"period":3.4}},"frog":{"name":"Frog Stretch","equipment":"Matte","steps":["Vierfüßlerstand, Knie so weit wie angenehm auseinander.","Unterschenkel parallel, Füße zeigen nach außen.","Hüfte langsam nach hinten schieben, bis du die Innenseite spürst."],"mistakes":"Kein stechender Schmerz – nur Zug.","why":"Adduktoren-Beweglichkeit für Spagat-Paraden.","sets":2,"reps":45,"unit":"s","prop":"mat","gym":null,"home":null,"photo":"Gen_frog","photoGym":null,"anim":{"a":"fr1","b":"fr2","hop":0,"period":4}},"couch":{"name":"Couch Stretch","equipment":"Matte, Wand oder S